{
  "datasets": [
    {
      "name": "5e219fb9",
      "displayName": "NASDAQ Market Radar: Catalyst Intelligence & Alpha Observatory.",
      "queryLines": [
        "SELECT \n",
        "    COUNT(*) AS TotalEvaluatedCatalysts,\n",
        "    ROUND(MAX(f.AlphaReturnPct), 2) AS MaxBullAlphaPct,\n",
        "    ROUND(MIN(f.AlphaReturnPct), 2) AS MaxBearAlphaPct,\n",
        "    ROUND(MAX(f.VolumeSurgeRatio), 1) AS MaxVolumeSurgeRatio,\n",
        "    ROUND(100.0 * SUM(CASE WHEN f.ReactionPattern = 'Sustained Move' THEN 1 ELSE 0 END) / COUNT(*), 1) AS SustainedMovePct\n",
        "FROM fact_news_impact f\n",
        "WHERE f.ImpactStatus = 'COMPLETED'\n",
        "  AND f.Symbol != 'QQQ';"
      ]
    },
    {
      "name": "d1493f65",
      "displayName": "media_story_clusters",
      "queryLines": [
        "SELECT \n",
        "    f.CatalystCategory AS StoryCluster,\n",
        "    COUNT(f.ArticleId) AS MediaBuzzCount,\n",
        "    CONCAT_WS(', ', COLLECT_SET(c.Symbol)) AS ImpactedTickers,\n",
        "    ROUND(AVG(f.TrueAlphaPct), 3) AS AvgAlphaPct,\n",
        "    ROUND(MAX(ABS(f.TrueAlphaPct)), 3) AS PeakAlphaPct,\n",
        "    ROUND(AVG(f.VolumeSurgeRatio), 2) AS AvgVolumeSurgeRatio,\n",
        "    ROUND(AVG(f.CompositeImpactScore), 1) AS AvgCompositeScore\n",
        "FROM fact_news_impact f\n",
        "JOIN dim_company c ON f.company_sk = c.company_sk\n",
        "WHERE f.ImpactStatus = 'COMPLETED'\n",
        "  AND f.Symbol != 'QQQ'\n",
        "GROUP BY f.CatalystCategory\n",
        "ORDER BY MediaBuzzCount DESC, PeakAlphaPct DESC;"
      ]
    },
    {
      "name": "9d3e5b05",
      "displayName": "macro_weather_gauge",
      "queryLines": [
        "SELECT \n",
        "    f.NewsTimestamp,\n",
        "    f.Headline,\n",
        "    f.Summary,\n",
        "    f.StockReturnPct AS QQQReturnPct,\n",
        "    f.VolumeSurgeRatio,\n",
        "    f.ReactionPattern,\n",
        "    f.CompositeImpactScore,\n",
        "    f.Url\n",
        "FROM fact_news_impact f\n",
        "WHERE f.Symbol = 'QQQ'\n",
        "ORDER BY f.NewsTimestamp DESC;"
      ]
    },
    {
      "name": "3329d388",
      "displayName": "company_catalyst_leaderboard",
      "queryLines": [
        "SELECT \n",
        "    c.Symbol,\n",
        "    c.CompanyName,\n",
        "    c.Sector,\n",
        "    f.NewsTimestamp,\n",
        "    f.Headline,\n",
        "    f.AlphaReturnPct,\n",
        "    f.StockReturnPct,\n",
        "    f.QQQReturnPct,\n",
        "    f.VolumeSurgeRatio,\n",
        "    f.ReactionPattern,\n",
        "    f.CompositeImpactScore,\n",
        "    f.ImpactStatus,\n",
        "    f.Url\n",
        "FROM fact_news_impact f\n",
        "JOIN dim_company c ON f.company_sk = c.company_sk\n",
        "WHERE f.Symbol != 'QQQ'\n",
        "ORDER BY ABS(f.AlphaReturnPct) DESC;"
      ]
    },
    {
      "name": "6f2ba89a",
      "displayName": "stock_price_history_5m",
      "queryLines": [
        "SELECT \n",
        "    p.Symbol,\n",
        "    p.PriceTimestamp,\n",
        "    p.Open,\n",
        "    p.High,\n",
        "    p.Low,\n",
        "    p.Close,\n",
        "    p.Volume,\n",
        "    n.Headline,\n",
        "    n.AlphaReturnPct,\n",
        "    n.CompositeImpactScore,\n",
        "    n.ReactionPattern\n",
        "FROM fact_stock_prices_5m p\n",
        "LEFT JOIN fact_news_impact n \n",
        "  ON p.Symbol = n.Symbol \n",
        " AND p.PriceTimestamp >= n.NewsTimestamp \n",
        " AND p.PriceTimestamp <= n.NewsTimestamp + INTERVAL 5 MINUTES\n",
        "ORDER BY p.PriceTimestamp ASC;"
      ]
    },
    {
      "name": "9990f459",
      "displayName": "news_signal_vs_noise_funnel",
      "queryLines": [
        "SELECT \n",
        "    COUNT(*) AS TotalEvaluatedNews,\n",
        "    SUM(CASE WHEN f.CausalityVerdict = 'Verified Catalyst' THEN 1 ELSE 0 END) AS RealMarketMovers,\n",
        "    SUM(CASE WHEN f.CausalityVerdict != 'Verified Catalyst' THEN 1 ELSE 0 END) AS IgnoredNoise,\n",
        "    SUM(CASE WHEN f.ReactionPattern = 'Reversal/Fade' THEN 1 ELSE 0 END) AS FakeoutSpikes,\n",
        "    CONCAT(ROUND(100.0 * SUM(CASE WHEN f.CausalityVerdict = 'Verified Catalyst' THEN 1 ELSE 0 END) / COUNT(*), 1), '%') AS RealMoverPct,\n",
        "    CONCAT(ROUND(100.0 * SUM(CASE WHEN f.CausalityVerdict != 'Verified Catalyst' THEN 1 ELSE 0 END) / COUNT(*), 1), '%') AS IgnoredNoisePct\n",
        "FROM fact_news_impact f\n",
        "WHERE f.ImpactStatus = 'COMPLETED'\n",
        "  AND f.Symbol != 'QQQ';\n"
      ]
    },
    {
      "name": "9fea89d6",
      "displayName": "top_catalyst_spotlight",
      "queryLines": [
        "WITH ranked AS (\n",
        "    SELECT \n",
        "        c.Symbol,\n",
        "        c.CompanyName,\n",
        "        f.Headline,\n",
        "        f.TrueAlphaPct,\n",
        "        f.StockReturnPct,\n",
        "        f.QQQReturnPct,\n",
        "        f.TickerBeta,\n",
        "        f.VolumeSurgeRatio,\n",
        "        ROW_NUMBER() OVER (ORDER BY f.TrueAlphaPct DESC) AS bull_rank,\n",
        "        ROW_NUMBER() OVER (ORDER BY f.TrueAlphaPct ASC) AS bear_rank\n",
        "    FROM fact_news_impact f\n",
        "    JOIN dim_company c ON f.company_sk = c.company_sk\n",
        "    WHERE f.ImpactStatus = 'COMPLETED' AND f.Symbol != 'QQQ'\n",
        ")\n",
        "SELECT \n",
        "    'Top Bull Catalyst (+True Alpha)' AS CatalystType,\n",
        "    Symbol,\n",
        "    CompanyName,\n",
        "    Headline,\n",
        "    TrueAlphaPct AS AlphaReturnPct,\n",
        "    CONCAT('Stock ', StockReturnPct, '% vs Beta ', TickerBeta, 'x QQQ (True Alpha: +', TrueAlphaPct, '%)') AS ReturnFormulaBreakdown,\n",
        "    CONCAT(VolumeSurgeRatio, 'x TOD Volume') AS VolumeSurgeDescription\n",
        "FROM ranked WHERE bull_rank = 1\n",
        "UNION ALL\n",
        "SELECT \n",
        "    'Top Bear Catalyst (-True Alpha)' AS CatalystType,\n",
        "    Symbol,\n",
        "    CompanyName,\n",
        "    Headline,\n",
        "    TrueAlphaPct AS AlphaReturnPct,\n",
        "    CONCAT('Stock ', StockReturnPct, '% vs Beta ', TickerBeta, 'x QQQ (True Alpha: ', TrueAlphaPct, '%)') AS ReturnFormulaBreakdown,\n",
        "    CONCAT(VolumeSurgeRatio, 'x TOD Volume') AS VolumeSurgeDescription\n",
        "FROM ranked WHERE bear_rank = 1;\n"
      ]
    }
  ],
